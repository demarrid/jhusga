// Prisma 7 no longer accepts `url` here. The connection string for migrate /
// introspect lives in prisma.config.ts; the runtime connection is supplied by
// the driver adapter in lib/prisma.ts.
datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Ingested documents
//
// Everything here is a projection of the SGA master Drive folder. Nothing in
// this section is authored by hand -- lib/sync.ts owns these rows, so a wipe
// and re-sync is always safe.
// ---------------------------------------------------------------------------

model Document {
    id String @id @default(uuid())

    // Drive identity. driveFileId is the key we reconcile against, not `id`,
    // because a doc can be renamed or moved between folders and still be the
    // same document.
    driveFileId String @unique
    source      String // webViewLink, for "open in Google Docs"
    mimeType    String @default("application/vnd.google-apps.document")

    // The Drive filename, verbatim. Kept because it is what the author
    // actually called the file, which is worth being able to show and search
    // even once the site presents a tidier name.
    title String

    // The name the site shows: the filename cleaned up, and for meetings
    // rewritten into one house style so a list of them reads consistently.
    // Derived in lib/titles.ts; falls back to `title` when empty.
    displayTitle String @default("")

    description String @default("")

    // Latest export, as markdown. Citation offsets index into this string, so
    // it must be the exact text the UI renders.
    content     String @default("")
    contentHash String @default("")

    // See DOCUMENT_KINDS in lib/kinds.ts. Kept a plain string rather than a
    // Postgres enum because the taxonomy grows as the SGA adds document types,
    // and a new kind should not require a schema migration.
    kind       String @default("unknown")
    folderPath String @default("")

    // How the document reached the archive: "walk" for a file found in the
    // master folder, "link" for one reached by following a link out of a
    // document already held -- the bill an agenda puts up for a reading, the
    // tracker a committee report points at. A linked document has no folder
    // path, because it does not live in the master folder at all, so this is
    // also what tells an empty folderPath apart from the folder root.
    discoveredVia String @default("walk")

    // Which SGA session this document belongs to. Files at the root of the
    // master folder are the current session; anything under a nested
    // "Nth SGA Master Folder" carries that session's number.
    //
    // Only the current session is eligible to source a generated summary --
    // superseded legislation is archive, and citing it as current law is
    // exactly the failure this whole pipeline exists to avoid.
    sessionNumber Int?

    // Groups the same document across sessions (every session's constitution,
    // say) so versions can be diffed. Derived in lib/lineage.ts.
    lineageKey String @default("")

    // The meeting this document belongs to, e.g. "113:senate:13". An agenda
    // and the minutes written from it share one key and differ by
    // meetingRole, which is what lets each link to the other. Empty for
    // anything that is not a meeting document. Derived in lib/meetings.ts.
    meetingKey  String @default("")
    // "agenda" | "minutes" | "" -- see MEETING_ROLES in lib/meetings.ts.
    meetingRole String @default("")

    // Drive's own timestamps. modifiedTime doubles as the check that lets an
    // unchanged file skip re-export; createdTime is shown to readers, for whom
    // "written in September, amended in March" is the interesting part.
    driveCreatedTime  DateTime?
    driveModifiedTime DateTime?
    lastSyncedAt      DateTime?

    // The date the document states about itself: the day a bill was read or
    // enacted, the day a meeting met, the byline under a report's title.
    // Derived by documentDate in lib/identity.ts, and stored rather than
    // computed on read because the listing and the search both file documents
    // by it, and neither can load every document's text to work it out.
    // Null when the document says nothing about when it happened, which is
    // when Drive's timestamps stand in; see listedDate in lib/dates.ts.
    datedAt DateTime?

    // Who Drive says owns and last touched the file. This is provenance, not
    // authorship: SGA files are frequently owned by whichever personal account
    // happened to create them, so it is recorded but never presented as "the
    // author". Named people come from DocumentContributor instead.
    driveOwnerName       String?
    driveOwnerEmail      String?
    driveLastEditorName  String?
    driveLastEditorEmail String?

    // Whether Drive lets an anonymous reader edit this file, i.e. whether it
    // is shared "anyone with the link can edit". Read from the capabilities
    // Drive reports to our own unauthenticated request, so it is the same
    // answer a stranger would get. Null when Drive did not say.
    anyoneCanEdit Boolean?

    // "published" -- `content` is the latest text Drive served.
    // "held"      -- a newer revision exists and is deliberately not published.
    //
    // A destructive change to a document anyone can edit is indistinguishable
    // from an amendment until somebody looks, so the site keeps serving the
    // last accepted text and says so. See lib/integrity.ts.
    reviewState    String    @default("published")
    heldRevisionId String?
    heldRevision   DocumentRevision? @relation("HeldRevision", fields: [heldRevisionId], references: [id], onDelete: SetNull)
    heldReason     String    @default("")
    heldAt         DateTime?

    // The content hash a reviewer rejected, so the next sync recognises the
    // same vandalism instead of queueing it again.
    rejectedContentHash String @default("")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    documentAnnotations DocumentAnnotation[]
    revisions           DocumentRevision[]
    contributors        DocumentContributor[]
    summary             DocumentSummary?
    passages            DocumentPassage[]

    // Documents this one links to, and the ones that link to it. Both sides
    // are the same rows read in opposite directions; see lib/links.ts.
    referencesOut DocumentReference[] @relation("ReferenceFrom")
    referencesIn  DocumentReference[] @relation("ReferenceTo")

    @@index([kind])
    @@index([driveModifiedTime])
    @@index([datedAt])
    @@index([sessionNumber])
    @@index([lineageKey, sessionNumber])
    @@index([driveOwnerEmail])
    @@index([meetingKey])
    @@index([reviewState])
}

// A link from one stored document to another, read out of the link the author
// actually typed into Google Docs.
//
// SGA agendas are mostly a list of links -- to the bill being read, to the
// guidelines being adopted -- so these edges are the real navigation graph of
// the archive. Rebuilt wholesale on every sync by lib/links.ts, because a
// dangling link becomes resolvable the moment its target is first ingested.
model DocumentReference {
    id String @id @default(uuid())

    fromDocumentId String
    fromDocument   Document @relation("ReferenceFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)

    toDocumentId String
    toDocument   Document @relation("ReferenceTo", fields: [toDocumentId], references: [id], onDelete: Cascade)

    // Where the link first appears in the source, so the sidebar can list
    // references in reading order rather than alphabetically.
    ordinal Int @default(0)

    // The link text the author wrote, which is usually a better label than the
    // target's Drive filename ("S.B.26-27.01 Rules Bill" vs "Copy of bill").
    anchorText String @default("")

    createdAt DateTime @default(now())

    // One edge per pair; a document linked three times is still one reference.
    @@unique([fromDocumentId, toDocumentId])
    @@index([toDocumentId])
}

// A person named by a document, and what they did on it.
//
// Derived by lib/contributors.ts from the labelled lines the SGA actually
// writes ("Sponsored by:", "Students Present:"). `evidence` keeps the source
// line so any name on the site can be traced back to the text that produced
// it, and `source` records whether a human or the parser asserted it.
model DocumentContributor {
    id String @id @default(uuid())

    documentId String
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    hopkinsAffiliateId String
    hopkinsAffiliate   HopkinsAffiliate @relation(fields: [hopkinsAffiliateId], references: [id], onDelete: Cascade)

    // See CONTRIBUTOR_ROLES in lib/contributors.ts.
    role String @default("present")

    // "parsed" | "drive" | "manual". A manual row is never overwritten by a
    // later sync, so corrections survive re-ingest.
    source String @default("parsed")

    // The line the parser read, verbatim.
    evidence String @default("")

    // A note that came with the name, e.g. "leaving early".
    note String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // One assertion per person per role per document.
    @@unique([documentId, hopkinsAffiliateId, role])
    @@index([hopkinsAffiliateId])
    @@index([role])
    @@index([documentId])
}

// Append-only history. Amendments are the whole point of this site, so we keep
// every distinct version we have ever seen rather than overwriting in place.
model DocumentRevision {
    id         String   @id @default(uuid())
    documentId String
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    title       String
    content     String
    contentHash String

    driveModifiedTime DateTime?
    fetchedAt         DateTime  @default(now())

    // Set when this revision is the one a reviewer accepted, and by whom.
    // A revision that was published automatically has neither.
    reviewedAt DateTime?
    reviewedBy String    @default("")

    // The document currently holding this revision back, if any.
    heldBy Document[] @relation("HeldRevision")

    // One row per distinct content hash per document.
    @@unique([documentId, contentHash])
    @@index([documentId, fetchedAt])
}

// A highlighted span of a document: the evidence a generated claim points at.
model DocumentAnnotation {
    id         String   @id @default(uuid())
    documentId String
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    // The verbatim quote, lifted character-for-character from Document.content.
    // This is the source of truth for the annotation.
    content String

    // Offsets are only a render cache. Re-exporting a document shifts them, so
    // lib/anchor.ts recomputes them from `content` after every sync.
    startOffset Int?
    endOffset   Int?

    // Set when `content` can no longer be found in the document, i.e. the
    // quoted passage was amended away. Sections citing it are marked stale.
    orphanedAt DateTime?

    label String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    citations        Citation[]
    summaryCitations DocumentSummaryCitation[]
    answerCitations  SearchAnswerCitation[]

    @@index([documentId])
    @@index([orphanedAt])
}

// One retrievable chunk of a document, for the search index.
//
// A reader's question is about a clause, not about a file, and matching whole
// documents answers "which of these 300 files mentions caucuses" when the
// question was "how many caucus senators are there". So the text is split at
// its own headings and paragraph breaks into passages small enough to be an
// answer on their own and large enough to still contain one.
//
// Derived data, rebuilt from Document.content whenever the text changes. The
// full-text index lives on an expression over `heading` and `content`; see the
// migration that adds this table. Offsets are a render cache in the same sense
// as DocumentAnnotation's, and nothing is ever cited from here -- a quote is
// always verified against the whole document.
model DocumentPassage {
    id         String   @id @default(uuid())
    documentId String
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    // Reading order within the document.
    ordinal Int

    // The heading trail this passage sits under ("Article IV > Section 2"),
    // indexed alongside the body so a question can match the heading that
    // names the topic even when the clause below never repeats the word.
    heading String @default("")

    content     String
    startOffset Int
    endOffset   Int

    createdAt DateTime @default(now())

    @@unique([documentId, ordinal])
    @@index([documentId])
}

// A natural-language question, and the cited answer read out of the archive.
//
// Answers are cached against a normalised form of the question so that a page
// view is not a model call, keeping the same rule as GeneratedSection: repeat
// askers are served from the database. Cached against the content hashes of
// the documents behind it, so an amendment invalidates the answer rather than
// leaving it quietly wrong -- and citations orphan the same way everything
// else does when the passage they quote is amended away.
model SearchAnswer {
    id String @id @default(uuid())

    // As typed, for display.
    question String

    // The normalised question plus scope; see lib/search.ts. Unique, because
    // this is the cache key.
    questionKey String @unique

    // "current" for this session's documents only, "all" to include the
    // archive. A historical question needs the archive; a question about the
    // rules in force must not be answered out of it.
    scope String @default("current")

    content String @default("")

    // "fresh" | "stale" | "empty" | "failed", as elsewhere.
    status String @default("empty")

    model      String  @default("")
    promptHash String  @default("")
    error      String?

    generatedAt DateTime?

    // How often this has been asked, which is what tells an editor which
    // questions deserve a written answer on a page instead.
    askedCount  Int      @default(0)
    lastAskedAt DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    citations SearchAnswerCitation[]

    @@index([status])
    @@index([lastAskedAt])
}

model SearchAnswerCitation {
    id String @id @default(uuid())

    answerId String
    answer   SearchAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

    annotationId String
    annotation   DocumentAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

    // The 1-based [n] marker in the answer text, less one.
    ordinal Int @default(0)

    @@unique([answerId, annotationId])
    @@index([annotationId])
}

// ---------------------------------------------------------------------------
// Generated content
//
// Cached model output. Every section is addressed by a stable `key` that a page
// asks for, so pages never call a model at request time.
// ---------------------------------------------------------------------------

model GeneratedSection {
    id String @id @default(uuid())

    // Stable slot, e.g. "about.executive.president". See SECTION_KEYS in
    // lib/sections.ts.
    key String @unique

    content String @default("")

    // "fresh" | "stale" | "failed" | "empty" -- see SectionStatus in lib/sections.ts.
    // Stale content is still served, flagged, rather than hidden.
    status String @default("empty")

    model       String    @default("")
    promptHash  String    @default("")
    error       String?
    generatedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    citations Citation[]

    @@index([status])
}

// Join between a generated section and the document span backing it. This is
// what SourceChip renders.
model Citation {
    id String @id @default(uuid())

    sectionId String
    section   GeneratedSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

    annotationId String
    annotation   DocumentAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

    // Display order of the chips within the section.
    ordinal Int @default(0)

    createdAt DateTime @default(now())

    @@unique([sectionId, annotationId])
    @@index([sectionId, ordinal])
}

// A plain-language reading of one document, generated from that document alone.
//
// Separate from GeneratedSection because the two answer different questions. A
// section answers a fixed question of the whole archive and may cite anything;
// a summary restates a single document and may only cite that document, which
// is what lets every claim link to a highlighted passage on the same page.
//
// The point is neutrality: SGA documents are written by whoever held the
// office, in wildly varying registers, and a reader should not have to infer
// what a meeting decided from the minute-taker's prose style.
model DocumentSummary {
    id String @id @default(uuid())

    documentId String   @unique
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    content String @default("")

    // "fresh" | "stale" | "failed" | "empty", as GeneratedSection. A summary
    // whose document has since been re-exported is served with a flag rather
    // than hidden.
    status String @default("empty")

    model String @default("")
    // Fingerprint of the prompt and the document's contentHash, so an
    // unchanged document is never re-summarised (or re-billed).
    promptHash  String    @default("")
    error       String?
    generatedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    citations DocumentSummaryCitation[]

    @@index([status])
}

// Join between a summary claim and the passage of its own document backing it.
model DocumentSummaryCitation {
    id String @id @default(uuid())

    summaryId String
    summary   DocumentSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

    annotationId String
    annotation   DocumentAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

    ordinal Int @default(0)

    createdAt DateTime @default(now())

    @@unique([summaryId, annotationId])
    @@index([summaryId, ordinal])
}

// One row per sync attempt, so a silently failing cron is visible.
model SyncRun {
    id String @id @default(uuid())

    // "running" | "success" | "error"
    status         String  @default("running")
    masterFolderId String  @default("")
    trigger        String  @default("manual") // "cron" | "manual"
    error          String?

    filesSeen           Int @default(0)
    documentsCreated    Int @default(0)
    documentsUpdated    Int @default(0)
    documentsUnchanged  Int @default(0)
    // Of the created/updated documents, how many belong to a prior session.
    documentsArchived   Int @default(0)
    annotationsOrphaned Int @default(0)
    sectionsInvalidated Int @default(0)
    contributorsLinked  Int @default(0)
    // Resolved links between two stored documents, rebuilt every run.
    referencesLinked    Int @default(0)
    // Agenda/minutes pairs the meeting matcher could join up.
    meetingsPaired      Int @default(0)

    startedAt  DateTime  @default(now())
    finishedAt DateTime?

    @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Accounts and community
// ---------------------------------------------------------------------------

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    affiliate HopkinsAffiliate?
}

// A person at the university: someone with a JHU Google account. Distinct from
// User, which is a login -- an affiliate exists whether or not they have ever
// signed in, because governing documents name officeholders regardless.
model HopkinsAffiliate {
    id          String @id @default(uuid())
    name        String
    description String @default("")

    // Case- and punctuation-insensitive form of `name`, so the same person
    // written two ways across documents resolves to one row. See nameKey in
    // lib/contributors.ts.
    nameKey String @unique @default("")

    // The JHU Google account: the only identity here that can be verified.
    email String? @unique

    // "full_time" | "part_time" | "transfer" | "non_degree" | "unknown".
    // See ENROLLMENT_STATUSES in lib/hopkins.ts for the canonical list.
    enrollmentStatus String @default("unknown")

    // Set once they have actually signed in.
    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    createdAt            DateTime              @default(now())
    updatedAt            DateTime              @updatedAt
    hopkinsRelationships HopkinsRelationship[]
    contributions        DocumentContributor[]
    aliases              HopkinsAlias[]

    // Only officers are ever attached to what they wrote; see ForumPost.
    forumSessions ForumSession[]
    forumPosts    ForumPost[]
    forumReplies  ForumReply[]

    @@index([enrollmentStatus])
    @@index([name])
}

// A short form that documents actually write -- a first name or a nickname --
// mapped onto the full-name affiliate it belongs to. "Sumi" and "Jazz" land
// here once they have been resolved, so later syncs do not re-ask.
model HopkinsAlias {
    id                 String           @id @default(uuid())
    alias              String
    aliasKey           String           @unique
    hopkinsAffiliateId String
    hopkinsAffiliate   HopkinsAffiliate @relation(fields: [hopkinsAffiliateId], references: [id], onDelete: Cascade)

    // "unique_given" | "unique_surname" | "model" | "manual"
    source String @default("model")

    createdAt DateTime @default(now())

    @@index([hopkinsAffiliateId])
}

// Anything a person can *be*: a position (Student Body President), a committee
// role (Chair of the Committee on Academic Affairs), a division (WSE), a level
// (undergraduate), or a cohort (Class of 2028).
//
// Rows rather than columns on the affiliate, because the set grows with every
// new committee and class year, and because a position deserves a description
// of its own.
model HopkinsCategory {
    id String @id @default(uuid())

    // "position" | "committee_role" | "division" | "level" | "cohort" | "other".
    // See HOPKINS_CATEGORY_TYPES in lib/hopkins.ts.
    type        String @default("other")
    name        String
    description String @default("")

    createdAt            DateTime              @default(now())
    updatedAt            DateTime              @updatedAt
    hopkinsRelationships HopkinsRelationship[]

    @@unique([type, name])
    @@index([type])
}

// "Is this person a WSE undergraduate in the class of 2028 who chairs Academic
// Affairs?" is four of these rows.
model HopkinsRelationship {
    id                 String           @id @default(uuid())
    hopkinsAffiliateId String
    hopkinsAffiliate   HopkinsAffiliate @relation(fields: [hopkinsAffiliateId], references: [id], onDelete: Cascade)
    hopkinsCategoryId  String
    hopkinsCategory    HopkinsCategory  @relation(fields: [hopkinsCategoryId], references: [id], onDelete: Cascade)

    // Positions turn over; a division or class year effectively does not.
    // endedAt null means currently held, which is what the site asks for when
    // it needs "who is president now" -- and keeping the ended rows is what
    // lets it answer "who was president in the 112th".
    startedAt DateTime?
    endedAt   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Someone can hold the same position in two non-consecutive terms, but not
    // twice from the same start date.
    @@unique([hopkinsAffiliateId, hopkinsCategoryId, startedAt])
    @@index([hopkinsAffiliateId])
    @@index([hopkinsCategoryId])
    @@index([endedAt])
}

// ---------------------------------------------------------------------------
// Forum
//
// The design constraint that shapes every model below: an anonymous post must
// stay anonymous against whoever holds this database, not merely against other
// readers. So the tables are arranged so that the join simply does not exist.
//
//   - A member's session records that somebody at Hopkins proved an address.
//     It does not record which address.
//   - An anonymous post has no author column at all -- not a session, not a
//     hash, not an address. There is nothing on the row to work back from.
//   - Rate limiting counts requests in a table that has no pointer to a post,
//     under a key that stops being computable once the day's salt rotates.
//
// Officers are the deliberate exception. A senator posting as a senator is
// posting on the record, and that row does name them.
// ---------------------------------------------------------------------------

model ForumCategory {
    id          String @id @default(uuid())
    slug        String @unique
    name        String
    description String @default("")
    ordinal     Int    @default(0)

    posts ForumPost[]
}

// A code emailed to a JHED address, waiting to be typed back in.
//
// The address is stored as an HMAC and never in the clear: this table exists
// to check one code, not to build a mailing list. Rows are deleted once used
// or expired, so in steady state it holds only codes in flight.
model LoginCode {
    id String @id @default(uuid())

    emailHash String
    codeHash  String

    createdAt DateTime  @default(now())
    expiresAt DateTime
    attempts  Int       @default(0)
    consumedAt DateTime?

    @@index([emailHash])
    @@index([expiresAt])
}

// Proof that somebody at Hopkins is behind a browser.
//
// For a member that is the entire content of the row: the address that proved
// it is not stored, so this session cannot be traced back to a person even
// with the database open. The affiliate is set only for officers, who have
// asked to be named.
model ForumSession {
    id        String   @id @default(uuid())
    tokenHash String   @unique
    createdAt DateTime @default(now())
    expiresAt DateTime

    // "member" | "officer" | "moderator"
    role String @default("member")

    hopkinsAffiliateId String?
    hopkinsAffiliate   HopkinsAffiliate? @relation(fields: [hopkinsAffiliateId], references: [id], onDelete: SetNull)

    @@index([expiresAt])
}

model ForumPost {
    id String @id @default(uuid())

    categoryId String
    category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

    title String
    body  String

    createdAt DateTime @default(now())

    // Set only when an officer chose to post on the record. Null is not "we
    // lost the author": it is the whole design.
    authorAffiliateId String?
    authorAffiliate   HopkinsAffiliate? @relation(fields: [authorAffiliateId], references: [id], onDelete: SetNull)

    // The office as it read on the day, so a post does not silently change
    // who it was from when its author leaves the seat.
    authorLabel String @default("")

    // There is no author-side delete, and so no token authorising one. A post
    // comes down only through a moderator, which puts it in ModerationAction
    // where everybody can see it. See the note in lib/login.ts.

    // "ok" | "flagged" | "skipped" -- what the screening in lib/moderate.ts
    // made of it. A flag holds the post back until a moderator looks, and the
    // hold is written to ModerationAction the moment it happens.
    screenState  String @default("skipped")
    screenReason String @default("")

    hiddenAt     DateTime?
    hiddenReason String    @default("")
    // "" when visible, otherwise "screen" or "moderator". Which one matters:
    // a moderator's decision has a person behind it and stays listed for
    // anyone to argue with, while a screening hold is provisional and is kept
    // out of the listing until somebody has actually looked at it.
    hiddenBy     String    @default("")
    lockedAt     DateTime?

    replies ForumReply[]

    @@index([categoryId, createdAt])
    @@index([createdAt])
    @@index([hiddenAt])
    @@index([hiddenBy])
    @@index([screenState])
}

model ForumReply {
    id String @id @default(uuid())

    postId String
    post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

    body      String
    createdAt DateTime @default(now())

    authorAffiliateId String?
    authorAffiliate   HopkinsAffiliate? @relation(fields: [authorAffiliateId], references: [id], onDelete: SetNull)
    authorLabel       String            @default("")

    screenState  String @default("skipped")
    screenReason String @default("")

    hiddenAt     DateTime?
    hiddenReason String    @default("")
    hiddenBy     String    @default("")

    @@index([postId, createdAt])
    @@index([hiddenBy])
    @@index([screenState])
}

// Every moderation action ever taken, in public and without exception.
//
// Append-only by convention and by the absence of any code that deletes from
// it. This is the whole basis on which a single moderator is acceptable: the
// power is unchecked, so its use has to be visible.
model ModerationAction {
    id String @id @default(uuid())

    // "post" | "reply"
    targetType String
    targetId   String

    // "hide" | "restore" | "lock" | "unlock"
    action String
    reason String @default("")

    // The moderator, named. Moderation is the one thing here that is never
    // anonymous.
    actorLabel String @default("")

    createdAt DateTime @default(now())

    @@index([createdAt])
    @@index([targetType, targetId])
}

// A counter for one client, one action, and one window.
//
// `key` is an HMAC over the action, the caller's address and the window start,
// under a salt that changes every day. No address is stored, nothing here
// points at a post, and once the day turns the key for a given address can no
// longer be recomputed -- so this table cannot be used to ask which posts came
// from where, only how many requests a window has already seen.
model RateBucket {
    key             String   @id
    count           Int      @default(0)
    windowStartedAt DateTime @default(now())
    expiresAt       DateTime

    @@index([expiresAt])
}
