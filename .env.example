# Database -----------------------------------------------------------------
# Postgres (Supabase). Both URLs come from the Supabase dashboard under
# Project Settings -> Database -> Connection string.
#
# The app connects through the transaction-mode pooler on port 6543. Serverless
# request handlers must use the pooler: each invocation borrows a connection
# instead of holding one open, which a direct connection cannot survive.
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations use the session-mode pooler on port 5432 instead. DDL and the
# advisory locks Prisma takes need a session that persists across statements,
# which transaction mode does not give. Only the CLI reads this.
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Google Drive -------------------------------------------------------------
# A plain API key is enough because the master folder is shared publicly
# ("anyone with the link"). Restrict the key to the Drive API in the Google
# Cloud console. If the folder is ever made private, this must become a
# service account instead.
GOOGLE_API_KEY=""

# Microsoft Graph (optional) ----------------------------------------------
# SharePoint / OneDrive sharing links in agendas (the Treasurer's report,
# for example) are followed the same way Drive links are. Anonymous "anyone
# with the link" shares need no token. Organisation-only links need an app in
# the JHU tenant with Files.Read.All (admin consent) or a Graph token from
# an account that can open the share.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional override: a raw Graph access token, for local testing.
MICROSOFT_GRAPH_TOKEN=""

# The one value that changes each year. Copy the folder ID out of the master
# folder URL: drive.google.com/drive/folders/<THIS_PART>
SGA_MASTER_FOLDER_ID="1FNVLX3o1QAulNi0JY7XwOxHpQ6Oa0KIg"

# Model provider -----------------------------------------------------------
# One of: anthropic | openai | gemini
AI_PROVIDER="openai"
AI_API_KEY=""
# Optional override; each provider has a sensible default in lib/ai.ts.
AI_MODEL=""
# Optional, OpenAI reasoning models only: none | low | medium | high. Reasoning
# is billed against the same budget as the answer, so lowering this makes the
# pipeline cheaper and faster on documents that do not need the deliberation.
# Left blank the provider default applies. An effort level the model does not
# accept is rejected outright, so check it against the model before setting it.
AI_REASONING_EFFORT=""

# Cron ---------------------------------------------------------------------
# Shared secret required by /api/cron/sync. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# Forum --------------------------------------------------------------------
# Sign-in codes go out through Resend. Without a key the forum still renders
# and is still readable; nobody can sign in, so nobody can post.
RESEND_API_KEY=""
# Must be an address on a domain verified in the Resend dashboard.
RESEND_FROM="SGA Archive <noreply@example.org>"

# Keys the HMACs that stand in for identity: the hash of an email address and
# the hash of a session token. Rotating it signs everyone out, so pick one and
# keep it. Generate with:
#   openssl rand -hex 32
FORUM_SECRET=""

# Keys the rate-limit buckets, mixed with the UTC date so the key for a given
# address stops being computable at midnight. Separate from FORUM_SECRET so
# that this one CAN be rotated freely -- doing so only resets the counters.
# Unset, each instance invents its own and says so in the log, which means
# limits are not shared between instances.
RATE_LIMIT_SALT=""

# Who may hide posts, as a comma-separated list of Hopkins addresses. Every
# action they take is published under their name in /discussion/moderation.
FORUM_MODERATOR_EMAILS=""
